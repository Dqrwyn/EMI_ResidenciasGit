# ==========================================================
#  Variables de entorno - Sistema de Residencias (EMI)
#  Copie este archivo como ".env" y ajuste los valores.
# ==========================================================

# Puerto del servidor de la API
PUERTO=4100

# desarrollo | produccion
ENTORNO=desarrollo

# Direcciones autorizadas a consumir la API (separadas por coma)
ORIGENES_PERMITIDOS=http://localhost:5180,http://127.0.0.1:5180,http://localhost:4173

# Cadena de conexion de MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/residencias_emi

# Clave para firmar los tokens de sesion (minimo 32 caracteres)
JWT_SECRETO=cambie-esta-clave-por-una-larga-y-segura-de-minimo-32-caracteres

# Duracion de la sesion
JWT_VIGENCIA=12h

# Nombre de la base de datos temporal que usan las pruebas de integracion
BD_VERIFICACION=residencias_emi_verificacion

# ----------------------------------------------------------
#  Cuenta inicial de administrador (la crea "npm run semilla")
# ----------------------------------------------------------
ADMIN_USUARIO=administrador
ADMIN_NOMBRE=Administrador del sistema
ADMIN_CONTRASENA=ResidenciasEMI2026

# Nivel de detalle de los registros: info | debug | warn | error
NIVEL_REGISTRO=info

# Intentos de ingreso permitidos por minuto desde una misma computadora
LIMITE_INTENTOS_INGRESO=10
